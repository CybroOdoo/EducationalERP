<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Enrollment sequence (used in Sprint 2) -->
    <record id="seq_education_enrollment" model="ir.sequence">
        <field name="name">Student Enrollment</field>
        <field name="code">education.enrollment</field>
        <field name="prefix">ENR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Application sequence (used in Sprint 2) -->
    <record id="seq_education_application" model="ir.sequence">
        <field name="name">Student Application</field>
        <field name="code">education.application</field>
        <field name="prefix">ADM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" ref="base.main_company"/>
    </record>


    <!-- Faculty ID sequence -->
    <record id="seq_education_faculty" model="ir.sequence">
        <field name="name">Faculty ID</field>
        <field name="code">education.faculty</field>
        <field name="prefix">FAC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

    <!-- Leave Request sequence (Sprint 3) -->
    <record id="seq_education_leave_request" model="ir.sequence">
        <field name="name">Student Leave Request</field>
        <field name="code">education.leave.request</field>
        <field name="prefix">LVE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="number_next">1</field>
        <field name="company_id" ref="base.main_company"/>
    </record>

 </odoo>