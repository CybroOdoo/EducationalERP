<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Educational ERP — Security Groups
        Source: Educational_ERP_Comprehensive_Project_Submission.docx — Table 22 / Table 63
        5 security groups covering all user roles in the institution.
    -->

    <!-- ── Module Category ──────────────────────────────────────────────── -->
    <record id="module_category_education" model="ir.module.category">
        <field name="name">Educational ERP</field>
        <field name="description">
            Educational ERP — LMS System by Cybrosys Techno Solutions.
            Covers all education institution roles: Admin, Admission, Teaching,
            Finance.
        </field>
        <field name="sequence">10</field>
    </record>

    <!-- ── Privileges (one per role — shown as rows in Settings > Users) ── -->
    <record id="res_groups_privilege_education_admin" model="res.groups.privilege">
        <field name="name">Administrator</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_education"/>
    </record>
    <record id="res_groups_privilege_education_admission" model="res.groups.privilege">
        <field name="name">Admission Officer</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_education"/>
    </record>
    <record id="res_groups_privilege_education_teacher" model="res.groups.privilege">
        <field name="name">Teacher</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_education"/>
    </record>
    <record id="res_groups_privilege_education_accountant" model="res.groups.privilege">
        <field name="name">Accountant</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_education"/>
    </record>

    <record id="res_groups_privilege_education_hostel_warden" model="res.groups.privilege">
        <field name="name">Hostel Warden</field>
        <field name="sequence">70</field>
        <field name="category_id" ref="module_category_education"/>
    </record>


    <!-- ── Group 1: Administrator ────────────────────────────────────────
         XML ID : group_education_admin
         Access : Full system access — all modules read/write/create/delete
         Also covers: Library Staff, Hostel Warden, Transport Manager (scoped)
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="group_education_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_education_admin"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">
            Full system access. All modules: read, write, create, delete.
            Scoped sub-roles: Library Staff, Hostel Warden, Transport Manager.
        </field>
    </record>

    <!-- ── Group 2: Admission Officer ───────────────────────────────────
         XML ID : group_education_admission_officer
         Access : Applications, enrollment, documents
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="group_education_admission_officer" model="res.groups">
        <field name="name">Admission Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_education_admission"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4,ref('base.group_partner_manager'))]"/>
        <field name="comment">
            Admissions operations: student applications, enrollment workflow,
            document checklist, admission reports.
        </field>
    </record>

    <!-- ── Group 3: Teacher ──────────────────────────────────────────────
         XML ID : group_education_teacher
         Access : Attendance, exams, LMS course delivery, own class timetable
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="group_education_teacher" model="res.groups">
        <field name="name">Teacher</field>
        <field name="privilege_id" ref="res_groups_privilege_education_teacher"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Teaching operations: attendance marking, exam result entry,
            LMS course creation and delivery, timetable view.
        </field>
    </record>


    <!-- ── Group 4: Accountant ───────────────────────────────────────────
         XML ID : group_education_accountant
         Access : Invoices, payments, financial reports
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="group_education_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="res_groups_privilege_education_accountant"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">
            Finance operations: fee invoices, payment recording,
            outstanding fee reports, hostel and transport billing.
        </field>
    </record>

    <!-- ── Group 5: Hostel Warden ─────────────────────────────────────────
         XML ID : group_education_hostel_warden
         Access : Hostel management and operations
    ─────────────────────────────────────────────────────────────────────── -->
    <record id="group_education_hostel_warden" model="res.groups">
        <field name="name">Hostel Warden</field>
        <field name="privilege_id" ref="res_groups_privilege_education_hostel_warden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')),(4, ref('account.group_account_invoice'))]"/>
        <field name="comment">
            Hostel operations: student accommodation, room allocation,
            hostel fee monitoring and daily hostel management.
        </field>
    </record>

 </odoo>