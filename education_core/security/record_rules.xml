        <field name="model_id" ref="model_hr_employee"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('education_core.group_education_admin')),
                                    (4, ref('education_core.group_education_teacher'))]"/>
    </record>

    <!-- ── Portal: student sees own documents only ────────────────────── -->
    <record id="rule_document_portal_own" model="ir.rule">
        <field name="name">Document: portal user sees own only</field>
        <field name="model_id" ref="model_education_document"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('enrollment_id.student_partner_id', '=', user.partner_id.id)]
        </field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>


    <!-- ── Multi-company: education.attendance.report ──────────────────── -->
    <record id="rule_attendance_report_company" model="ir.rule">
        <field name="name">Attendance Analysis: company isolation</field>
        <field name="model_id" ref="model_education_attendance_report"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>