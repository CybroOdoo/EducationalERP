    <!-- ── Portal: student sees own application only ─────────────────── -->
    <record id="rule_application_portal_own" model="ir.rule">
        <field name="name">Application: portal user sees own only</field>
        <field name="model_id" ref="model_education_application"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('email', '=', user.email)]
        </field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

