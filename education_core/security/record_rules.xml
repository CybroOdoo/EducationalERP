<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        education_core — Record Rules
        Source: Educational_ERP_Comprehensive_Project_Submission.docx
        Multi-company isolation rules for all core models.
        Additional row-level rules (student own-record, teacher own-class)
        are added in Sprint 2 when enrollment and attendance are implemented.
    -->

    <!-- ── Multi-company: education.academic.year ─────────────────────── -->
    <record id="rule_academic_year_company" model="ir.rule">
        <field name="name">Academic Year: company isolation</field>
        <field name="model_id" ref="model_education_academic_year"/>
        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- ── Multi-company: education.department ───────────────────────── -->
    <record id="rule_department_company" model="ir.rule">
        <field name="name">Department: company isolation</field>
