<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action filtered to Documents for an application (smart button) -->
    <record id="education_document_action_application" model="ir.actions.act_window">
        <field name="name">Application Documents</field>
        <field name="path">application_documnets</field>
        <field name="res_model">education.document</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('application_id', '=', active_id)]</field>
        <field name="context">{'default_application_id': active_id}</field>
    </record>

    <!-- ── Form View ──────────────────────────────────────────────────────── -->
    <record id="education_application_view_form" model="ir.ui.view">
        <field name="name">education.application.form</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <form string="Student Application">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit Application"
                            class="btn-primary"
                            data-hotkey="q"
                            invisible="state != 'draft'"/>
                    <button name="action_create_fee" type="object"
                            string="Create Fee"
                            class="btn-primary"
                            groups="education_core.group_education_admin,education_core.group_education_admission_officer"
                            invisible="not admission_fee or admission_fee_invoice_id and state!='draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            class="btn-primary"
                            data-hotkey="v"
                            groups="education_core.group_education_admin,education_core.group_education_admission_officer"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object"
                            string="Reject"
                            class="btn-secondary"
                            data-hotkey="x"
                            groups="education_core.group_education_admin,education_core.group_education_admission_officer"
                            invisible="state != 'submitted'"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state != 'rejected'"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <!-- Invisible fields required for modifier evaluation -->
                    <field name="enrollment_id" invisible="1"/>
                    <field name="active" invisible="1"/>

                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollment" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap"
                                invisible="not enrollment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Enrollment</span>
                            </div>
                        </button>
                        <button name="%(education_document_action_application)d"
                                type="action"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo" string="Documents"/>
                        </button>
                        <button name="action_view_invoice" type="object" class="oe_stat_button" invisible="not admission_fee">
                            <field name="admission_fee" widget="statinfo" string="Admission Fee"/>
                        </button>
                    </div>

                    <field name="photo" widget="image" class="oe_avatar"
                           options="{'preview_image': 'photo', 'size': [96, 96]}"/>

                    <div class="oe_title">
                        <label for="first_name" string="Applicant Name"/>
                        <h1>
                            <field name="first_name" placeholder="First Name" class="me-2"/>
                            <field name="last_name" placeholder="Last Name"/>
                        </h1>
                        <h2>
                            <field name="admission_no" class="text-muted"/>
                        </h2>
                    </div>

                    <notebook>
                        <page string="Personal Information" name="personal">
                            <group name="personal_main">
                                <group name="personal_left">
                                    <field name="date_of_birth"/>
                                    <field name="age" readonly="1"/>
                                    <field name="gender"/>
                                    <field name="blood_group"/>
                                    <field name="nationality_id" options="{'no_open': True, 'no_create': True}"/>
                                </group>
                                <group name="personal_right">
                                    <field name="email" widget="email"/>
                                    <field name="phone" widget="phone"/>
                                    <field name="mobile" widget="phone"/>
                                </group>
                            </group>
                            <group name="address" string="Address">
                                <group name="address_left">
                                    <field name="address" placeholder="Street address..."/>
                                    <field name="city"/>
                                    <field name="zip_code"/>
                                </group>
                                <group name="address_right">
                                    <field name="country_id" options="{'no_open': True, 'no_create': True}"/>
                                    <field name="state_id" domain="[('country_id', '=', country_id)]"
                                           options="{'no_open': True, 'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Academic" name="academic">
                            <group name="academic_main">
                                <group name="academic_details">
                                    <field name="program_id"/>
                                    <field name="department_id" readonly="1"/>
                                    <field name="academic_year_id" options="{'no_create': True}"/>
                                    <field name="admission_fee"/>
                                </group>
                                <group name="previous_education" string="Previous Education">
                                    <field name="last_school"/>
                                    <field name="last_qualification"/>
                                    <field name="last_percentage"/>
                                </group>
                            </group>
                        </page>

                        <page string="Guardian / Parent" name="guardian">
                            <group name="guardian_main">
                                <group name="guardian_info">
                                    <field name="guardian_name"/>
                                    <field name="guardian_relation"/>
                                    <field name="guardian_occupation"/>
                                </group>
                                <group name="guardian_contact">
                                    <field name="guardian_phone" widget="phone"/>
                                    <field name="guardian_email" widget="email"/>
                                </group>
                            </group>
                        </page>

                        <page string="Documents" name="documents">
                            <field name="document_ids" mode="list" nolabel="1" required="document_ids.is_mandatory">
                                <list string="Documents" editable="bottom">
                                    <field name="document_type_id"/>
                                    <field name="is_mandatory" readonly="1"/>
                                    <field name="file_name" column_invisible="1" required="is_mandatory"/>
                                    <field name="file" filename="file_name"
                                           options="{'accepted_file_extensions': '.pdf,.jpg,.jpeg,.png'}"
                                           required="is_mandatory"/>
                                    <field name="expiry_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'verified'"
                                           decoration-warning="state == 'uploaded'"
                                           decoration-danger="state == 'rejected'"
                                           decoration-muted="state == 'pending'"/>
                                    <button name="action_verify" type="object"
                                            string="Verify" icon="fa-check"
                                            invisible="state != 'uploaded'"
                                            groups="education_core.group_education_admin,education_core.group_education_admission_officer"/>
                                </list>
                            </field>
                        </page>

                        <page string="Rejection Details" name="rejection" invisible="state != 'rejected'">
                            <group name="rejection_details">
                                <field name="rejection_reason" readonly="1"/>
                                <field name="rejected_by_id" readonly="1" options="{'no_open': True}"/>
                                <field name="rejection_date" readonly="1"/>
                            </group>
                        </page>

                        <page string="Internal Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes (not visible to applicant)..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── List View ──────────────────────────────────────────────────────── -->
    <record id="education_application_view_list" model="ir.ui.view">
        <field name="name">education.application.list</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <list string="Student Applications" default_order="date_application desc" sample="1">
                <field name="admission_no" decoration-bf="1"/>
                <field name="name" string="Applicant"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <field name="date_application" optional="show"/>
                <field name="email" optional="show"/>
                <field name="phone" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-warning="state == 'submitted'"
                       decoration-danger="state == 'rejected'"
                       decoration-muted="state == 'draft'"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Kanban View ────────────────────────────────────────────────────── -->
    <record id="education_application_view_kanban" model="ir.ui.view">
        <field name="name">education.application.kanban</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    records_draggable="false" quick_create="false" sample="1">
                <field name="state"/>
                <field name="name"/>
                <field name="admission_no"/>
                <field name="program_id"/>
                <field name="date_application"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <small class="o_kanban_record_subtitle text-muted">
                                    <field name="admission_no"/>
                                </small>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div><field name="program_id"/></div>
                            <div class="text-muted small">
                                <field name="date_application"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Search View ────────────────────────────────────────────────────── -->
    <record id="education_application_view_search" model="ir.ui.view">
        <field name="name">education.application.search</field>
        <field name="model">education.application</field>
        <field name="arch" type="xml">
            <search string="Search Applications">
                <field name="admission_no"/>
                <field name="name" string="Applicant Name"
                       filter_domain="['|', ('first_name', 'ilike', self), ('last_name', 'ilike', self)]"/>
                <field name="phone" string="Phone / Mobile"
                       filter_domain="['|', ('phone', 'ilike', self), ('mobile', 'ilike', self)]"/>
                <field name="email"/>
                <field name="program_id"/>
                <field name="academic_year_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Current Year" name="current_year" domain="[('academic_year_id.is_current', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Program" name="group_program" context="{'group_by': 'program_id'}"/>
                    <filter string="Academic Year" name="group_year" context="{'group_by': 'academic_year_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ──────────────────────────────────────────────────── -->
    <record id="education_application_action" model="ir.actions.act_window">
        <field name="name">Student Applications</field>
        <field name="path">applications</field>
        <field name="res_model">education.application</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="education_application_view_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No applications yet
            </p>
            <p>
                Create a new application to begin the admission process.
            </p>
        </field>
    </record>
</odoo>