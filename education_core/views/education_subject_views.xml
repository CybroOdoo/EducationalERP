<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Program Form Extension: Subjects Tab ─────────────────────── -->
    <record id="education_program_view_form_inherit_subjects" model="ir.ui.view">
        <field name="name">education.program.form.inherit.subjects</field>
        <field name="model">education.program</field>
        <field name="inherit_id" ref="education_core.education_program_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Subjects" name="subjects">
                    <field name="subject_ids">
                        <list editable="bottom" default_order="sequence, name">
                            <field name="sequence" widget="handle"/>
                            <field name="code" decoration-bf="1"/>
                            <field name="name"/>
                            <field name="active" column_invisible="1"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Form View ────────────────────────────────────────────────── -->
    <record id="education_subject_view_form" model="ir.ui.view">
        <field name="name">education.subject.form</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <form string="Subject">
                <sheet>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Data Structures &amp; Algorithms"/>
                        </h1>
                        <h2>
                            <field name="code" placeholder="e.g. CS101" class="text-muted"/>
                        </h2>
                    </div>

                    <group name="main">
                        <group name="subject_details">
                            <field name="program_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── List View ────────────────────────────────────────────────── -->
    <record id="education_subject_view_list" model="ir.ui.view">
        <field name="name">education.subject.list</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <list string="Subjects" editable="bottom" default_order="program_id, sequence, name" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="program_id" options="{'no_create': True}"/>
                <field name="code" decoration-bf="1"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ── Search View ──────────────────────────────────────────────── -->
    <record id="education_subject_view_search" model="ir.ui.view">
        <field name="name">education.subject.search</field>
        <field name="model">education.subject</field>
        <field name="arch" type="xml">
            <search string="Search Subjects">
                <field name="name" string="Subject"
                       filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="code"/>
                <field name="program_id"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Program" name="group_by_program"
                            context="{'group_by': 'program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ────────────────────────────────────────────── -->
    <record id="education_subject_action" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="path">subjects</field>
        <field name="res_model">education.subject</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="education_subject_view_search"/>
        <field name="context">{'search_default_group_by_program': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define your academic subjects
            </p>
            <p>
                Configure courses and subjects taught within each academic program.
            </p>
        </field>
    </record>

</odoo>