<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard: set / reset a student's portal password (admin only, modal without <sheet>) -->
    <record id="education_portal_password_view_form" model="ir.ui.view">
        <field name="name">education.portal.password.form</field>
        <field name="model">education.portal.password</field>
        <field name="arch" type="xml">
            <form string="Set Portal Password">
                <div class="alert alert-warning" role="alert">
                    Passwords are stored encrypted and cannot be viewed later.
                    Copy this password now and share it securely with the student.
                </div>
                <group>
                    <field name="enrollment_id" invisible="1"/>
                    <field name="user_id" invisible="1"/>
                    <field name="login"/>
                    <field name="new_password"/>
                </group>
                <footer>
                    <button name="action_set_password" type="object"
                            string="Set Password" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>